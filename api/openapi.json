{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "StatusController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        },
        "tags": [
          "Status"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "StatusController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TerminusHealthCheckResult"
                    }
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "error": {
                      "example": {}
                    },
                    "details": {
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TerminusHealthCheckResult"
                    }
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "error": {
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      }
                    },
                    "details": {
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Status"
        ]
      }
    },
    "/api/greeting": {
      "get": {
        "operationId": "StatusController_greeting",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Greeting"
                }
              }
            }
          }
        },
        "tags": [
          "Status"
        ]
      }
    },
    "/api/auth/telegram": {
      "post": {
        "operationId": "TelegramAuthController_exchange",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "initData"
                ],
                "properties": {
                  "initData": {
                    "type": "string",
                    "maxLength": 8192
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelegramToken"
                }
              }
            }
          }
        },
        "tags": [
          "TelegramAuth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "TelegramAuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelegramUser"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "TelegramAuth"
        ]
      }
    }
  },
  "info": {
    "title": "Starter API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Status",
      "description": "API liveness, dependency readiness and localized greeting"
    },
    {
      "name": "TelegramAuth",
      "description": "Exchange Telegram launch data for an access token and read the current profile"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "TerminusHealthIndicatorResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "degraded",
              "down"
            ],
            "description": "The status of this health indicator"
          },
          "responseTime": {
            "type": "number",
            "description": "Time the health indicator took to respond, in ms"
          },
          "cachedResponse": {
            "type": "boolean",
            "description": "Whether this result was served from the cache"
          }
        },
        "required": [
          "status"
        ]
      },
      "TerminusHealthCheckResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error",
              "ok",
              "degraded",
              "shutting_down"
            ],
            "example": "ok"
          },
          "info": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            },
            "nullable": true
          },
          "error": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {},
            "nullable": true
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            }
          }
        },
        "required": [
          "status",
          "details"
        ]
      },
      "Greeting": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Hello"
          }
        },
        "required": [
          "message"
        ]
      },
      "TelegramToken": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      },
      "TelegramUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  }
}
