    "/api/health/ready": {
      "get": {
        "operationId": "StatusController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TerminusHealthCheckResult"
                    }
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "error": {
                      "example": {}
                    },
                    "details": {
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequestsErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/TerminusHealthCheckResult"
                        }
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "error",
                            "shutting_down"
                          ],
                          "example": "error"
                        },
                        "error": {
                          "example": {
                            "redis": {
                              "status": "down",
                              "message": "Could not connect",
                              "responseTime": 3005
                            }
                          }
                        },
                        "details": {
                          "example": {
                            "database": {
                              "status": "up",
                              "responseTime": 12
                            },
                            "redis": {
                              "status": "down",
                              "message": "Could not connect",
                              "responseTime": 3005
                            }
                          }
                        }
                      }
                    },
                    {
                      "$ref": "#/components/schemas/ServiceUnavailableErrorResponseDto"
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Status"
        ]
      }
    },
