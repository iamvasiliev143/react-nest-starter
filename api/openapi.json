  "info": {
    "title": "Starter API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Status",
      "description": "API liveness, dependency readiness and localized greeting"
    },
    {
      "name": "TelegramAuth",
      "description": "Exchange Telegram launch data for an access token and read the current profile"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "TerminusHealthIndicatorResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "degraded",
              "down"
            ],
            "description": "The status of this health indicator"
          },
          "responseTime": {
            "type": "number",
            "description": "Time the health indicator took to respond, in ms"
          },
          "cachedResponse": {
            "type": "boolean",
            "description": "Whether this result was served from the cache"
          }
        },
        "required": [
          "status"
        ]
      },
      "TerminusHealthCheckResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error",
              "ok",
              "degraded",
              "shutting_down"
            ],
            "example": "ok"
          },
          "info": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            },
            "nullable": true
          },
          "error": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {},
            "nullable": true
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            }
          }
        },
        "required": [
          "status",
          "details"
        ]
      },
      "AppStatus": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "active",
              "maintenance"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "Greeting": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Hello"
          }
        },
        "required": [
          "message"
        ]
      },
      "TelegramToken": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      },
      "TelegramReferralLinks": {
        "type": "object",
        "properties": {
          "bot": {
            "type": "string",
            "format": "uri"
          },
          "miniApp": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "bot",
          "miniApp"
        ]
      },
      "TelegramUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "referralCode": {
            "type": "string",
            "pattern": "^r[A-Za-z0-9_-]{16}$"
          },
          "referralLinks": {
            "$ref": "#/components/schemas/TelegramReferralLinks"
          }
        },
        "required": [
          "id",
          "referralCode"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "HTTP_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Request failed"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "requestId"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "email"
          },
          "message": {
            "type": "string",
            "example": "Invalid value"
          }
        },
        "required": [
          "path",
          "message"
        ]
      },
      "BadRequestErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400,
            "enum": [
              400
            ]
          },
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST",
            "enum": [
              "INVALID_REQUEST"
            ]
          },
          "message": {
            "type": "string",
            "example": "Invalid request"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "requestId"
        ]
      },
      "UnauthorizedErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401,
            "enum": [
              401
            ]
          },
          "code": {
            "type": "string",
            "example": "UNAUTHORIZED",
            "enum": [
              "UNAUTHORIZED"
            ]
          },
          "message": {
            "type": "string",
            "example": "Authentication required"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "requestId"
        ]
      },
      "ForbiddenErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 403,
            "enum": [
              403
            ]
          },
          "code": {
            "type": "string",
            "example": "FORBIDDEN",
            "enum": [
              "FORBIDDEN"
            ]
          },
