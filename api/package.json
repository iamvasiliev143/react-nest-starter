{
  "name": "starter-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/errors.test.mjs test/environment.test.mjs test/health.test.mjs test/auth-disabled.test.mjs test/queues.test.mjs test/realtime.test.mjs",
    "build": "nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrate": "node scripts/migrate.mjs",
    "openapi": "npm run build && node scripts/export-openapi.mjs"
  },
  "dependencies": {
    "@nestjs/authentication": "0.1.6",
    "@nestjs/authorization": "0.1.4",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/i18n": "^0.0.3",
    "@nestjs/observe": "^0.3.26",
    "@nestjs/platform-node": "12.5.1",
    "@nestjs/platform-socket.io": "12.5.1",
    "@nestjs/storage": "^0.0.5",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "12.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "12.5.1",
    "@socket.io/redis-adapter": "8.3.0",
    "@tma.js/init-data-node": "^2.0.8",
    "bullmq": "^6.7.8",
    "drizzle-orm": "^0.45.4",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "4.8.4"
  },
  "type": "module"
}
