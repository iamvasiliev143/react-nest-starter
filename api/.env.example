# Локальная разработка. Скопируй в api/.env и при необходимости задай секреты.
# Значения ниже подходят для сервисов из docker-compose.yml и не содержат секретов.
HOST=127.0.0.1
PORT=3000
STORAGE_PATH=.storage
DATABASE_URL=postgresql://starter:starter-local@127.0.0.1:5434/starter
REDIS_URL=redis://127.0.0.1:6380

# Вход через Telegram: задай оба значения или оставь оба пустыми.
# Секреты храни только в api/.env, он не попадает в Git.
TELEGRAM_BOT_TOKEN=
AUTH_TOKEN_SECRET=

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
