# HTTP-сервер
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://starter:starter-local@127.0.0.1:5434/starter

# Redis и фоновые задачи
REDIS_URL=redis://127.0.0.1:6380
QUEUE_REDIS_URL=redis://127.0.0.1:6380/5
REALTIME_CHANNEL=starter-api:realtime
THROTTLER_KEY_PREFIX=throttler

# Файловое хранилище S3
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_BUCKET=starter
S3_ACCESS_KEY_ID=starter
S3_SECRET_ACCESS_KEY=starter-local-secret

# Авторизация Telegram
TELEGRAM_BOT_TOKEN=
AUTH_TOKEN_SECRET=

# Кнопка меню Telegram Mini App
# Username бота без @. Нужен для выдачи реферальных ссылок.
TELEGRAM_BOT_USERNAME=
# Часть адреса t.me/<bot>/<short_name> из BotFather → Direct Links.
# Если оставить пустым, ссылка ведёт в Main Mini App.
TELEGRAM_MINI_APP_SHORT_NAME=
# Включать только на одном экземпляре API на токен, без webhook.
TELEGRAM_BOT_POLLING_ENABLED=false
TELEGRAM_MINI_APP_URL=
TELEGRAM_MINI_APP_BUTTON_TEXT="Открыть приложение"
# default — стандартная высота Telegram
# expanded — развёрнутое окно на доступную высоту
# fullscreen — полноэкранный режим, с переходом на expanded при отсутствии поддержки
TELEGRAM_MINI_APP_SIZE=default

# TON Center API
TON_CENTER_API_KEY=

# Наблюдаемость NestJS Observe
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
