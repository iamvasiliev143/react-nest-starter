{
  "name": "starter-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "api:types": "openapi-typescript ../api/openapi.json -o src/api-schema.d.ts",
    "test": "vitest run --environment jsdom src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^7.0.7",
    "@tanstack/react-query": "^5.108.0",
    "@tma.js/sdk-react": "3.0.23",
    "date-fns": "^4.4.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "vite": "^7.3.0",
    "vitest": "^5.1.1"
  }
}
