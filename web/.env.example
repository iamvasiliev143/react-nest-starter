# Telegram Analytics. Replace the blank values with your SDK credentials.
VITE_TELEGRAM_ANALYTICS_TOKEN= # YOUR_ANALYTICS_SDK_TOKEN
VITE_TELEGRAM_ANALYTICS_APP_NAME= # YOUR_ANALYTICS_IDENTIFIER

# TON Connect. Example: https://your-app.example/tonconnect-manifest.json
VITE_TONCONNECT_MANIFEST_URL=

# ngrok development tunnel. Use a hostname without https:// or a path.
NGROK_AUTHTOKEN=
NGROK_DOMAIN= # your-host.ngrok-free.app
