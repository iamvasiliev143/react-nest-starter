{
  "name": "react-nest-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "api"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w api\" \"npm run dev -w web\"",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "build": "npm run build --workspaces",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "lefthook install",
    "graph:update": "engram update . --no-description --no-label",
    "graph:summary": "engram summary --graph .engram/graph.json",
    "graph:query": "engram query --graph .engram/graph.json",
    "api:types": "npm run openapi -w api && npm run api:types -w web",
    "db:migrate": "npm run db:migrate -w api",
    "test:e2e": "npm run test:e2e -w web"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@sentropic/engram": "0.28.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
